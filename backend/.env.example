# Port the API listens on
PORT=8080

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stanzin_travels?sslmode=disable

# Comma-separated origins allowed to call the API from a browser
# (customer site on 3000, admin dashboard on 3001)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Secret used to sign dashboard JWTs — set a strong value in production
JWT_SECRET=dev-only-secret-change-in-production
